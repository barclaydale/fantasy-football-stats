# Copy to .env for local dev, or run `vercel env pull .env` once the project is
# linked to Vercel with a Postgres database attached.

# Postgres. On Vercel these two are set for you by the Neon storage integration
# ("Connect to Project" on the database). DATABASE_URL is the pooled connection,
# DATABASE_URL_UNPOOLED the direct one (needed for migrations).
DATABASE_URL="postgresql://user:password@localhost:5432/fantasy_football_stats"
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/fantasy_football_stats"
