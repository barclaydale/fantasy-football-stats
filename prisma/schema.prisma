// Prisma schema for the fantasy football stats dashboard.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Var names match what Vercel's Postgres (Neon) storage integration sets when you
// click "Connect to Project" on the database: DATABASE_URL (pooled, via pgbouncer)
// and DATABASE_URL_UNPOOLED (direct connection, needed for migrations).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// One fantasy team in the league.
model Team {
  id        String   @id @default(cuid())
  name      String
  ownerName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players Player[]
}

// One real NFL player, synced daily from Sleeper (id = Sleeper's own player_id,
// so re-syncing is a plain upsert). `fantasyTeamId` is the fantasy team that
// currently rosters them; null means a free agent. Team defenses are players
// too here (id = team abbreviation, e.g. "HOU"), matching how Sleeper models them.
model Player {
  id                 String  @id
  firstName          String?
  lastName           String?
  fullName           String?
  position           String? // QB | RB | WR | TE | K | DEF | ...
  fantasyPositions   String[]
  nflTeam            String? // pro team abbreviation, e.g. "KC"; null if a free agent/retired
  status             String? // Active | Inactive | Injured Reserve | Practice Squad | ...
  injuryStatus       String? // Questionable | Doubtful | Out | IR | ...
  injuryBodyPart     String?
  injuryNotes        String?
  age                Int?
  yearsExp           Int?
  depthChartPosition String?
  depthChartOrder    Int?
  // Sleeper's own fame/relevance ranking (lower = more relevant); used to sort
  // the free-agent list so stars surface before deep-bench scrubs.
  searchRank         Int?
  active             Boolean  @default(true)
  syncedAt           DateTime @default(now())

  fantasyTeamId String?
  fantasyTeam   Team?   @relation(fields: [fantasyTeamId], references: [id], onDelete: SetNull)
  // Which lineup slot they fill on that fantasy team: QB | RB | WR | TE | WRT
  // (flex) | K | DEF | BN (bench). Meaningless for free agents (fantasyTeamId
  // null) — ignored there. Slot capacities live in src/lib/roster-slots.ts.
  rosterSlot String @default("BN")

  statLines   PlayerStatLine[]
  projections PlayerProjection[]

  @@index([fantasyTeamId])
  @@index([position])
  @@index([searchRank])
}

// One player's full stat line for one week, straight from Sleeper's stats API.
// `stats` keeps the entire raw payload (it varies a lot by position — passing,
// rushing, receiving, IDP, kicking, punting, team-defense-allowed, snap counts,
// red zone, etc., over 200 possible keys) so new stats/views can be built later
// without re-fetching history. The box-score basics below are pulled out as
// columns (snake_case Sleeper keys in parens) since season-stats pages need to
// SUM/AVG them directly rather than reach into JSON every time.
model PlayerStatLine {
  id         String   @id @default(cuid())
  playerId   String
  season     Int
  week       Int
  seasonType String   @default("regular") // regular | post | pre
  nflTeam    String?
  opponent   String?
  stats      Json
  ptsStd     Float?
  ptsPpr     Float?
  ptsHalfPpr Float?

  recTargets Float? // rec_tgt
  rec        Float? // rec
  recYards   Float? // rec_yd
  recTds     Float? // rec_td
  rushAtt    Float? // rush_att
  rushYards  Float? // rush_yd
  rushTds    Float? // rush_td
  passAtt    Float? // pass_att
  passCmp    Float? // pass_cmp
  passYards  Float? // pass_yd
  passTds    Float? // pass_td
  passInt    Float? // pass_int

  // Snap % = offSnaps / teamOffSnaps. Sleeper doesn't report a percentage directly.
  offSnaps     Float? // off_snp
  teamOffSnaps Float? // tm_off_snp

  updatedAt DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season, week, seasonType])
  @@index([season, week])
}

// Same shape as PlayerStatLine but for Sleeper's projections (not-yet-played
// games), from the same API family — same stat keys, "proj" instead of "stat".
model PlayerProjection {
  id         String   @id @default(cuid())
  playerId   String
  season     Int
  week       Int
  seasonType String   @default("regular")
  nflTeam    String?
  opponent   String?
  stats      Json
  ptsStd     Float?
  ptsPpr     Float?
  ptsHalfPpr Float?

  rec       Float?
  recYards  Float?
  recTds    Float?
  rushAtt   Float?
  rushYards Float?
  rushTds   Float?
  passAtt   Float?
  passCmp   Float?
  passYards Float?
  passTds   Float?
  passInt   Float?

  updatedAt DateTime @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season, week, seasonType])
  @@index([season, week])
}

// Singleton row (id always 1) tracking the last successful Sleeper sync, so
// the UI knows which season/week's stats it's showing without calling Sleeper
// on every page load.
model SyncState {
  id           Int       @id @default(1)
  season       Int?
  week         Int?
  seasonType   String?
  lastSyncedAt DateTime?
  lastError    String?
}
